#define NOMINMAX
#include <windows.h>
#include <algorithm>
#include <array>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <limits>
#include <stdexcept>
#include <thread>
#include "@PRODUCTION_CPP@"

using namespace Libs::VrTracker2;
using namespace Libs::Graphics::Vr;
static unsigned checks = 0;
static void Require(bool value, const char* message) {
    ++checks;
    if (!value) throw std::runtime_error(message);
}
static bool Near(float a, float b) { return std::abs(a-b) < 0.00002f; }
static float F(const uint8_t* bytes, size_t at) { float x; std::memcpy(&x, bytes+at, 4); return x; }
static uint32_t U(const uint8_t* bytes, size_t at) { uint32_t x; std::memcpy(&x, bytes+at, 4); return x; }
static void Identity(float (&m)[3][4]) { std::memset(m, 0, sizeof(m)); for(unsigned i=0;i<3;++i)m[i][i]=1; }
static void SetupHost() {
    fake_headset = {}; fake_pose = {};
    fake_headset.connected = true;
    Identity(fake_headset.eyes[0].eye_to_head); Identity(fake_headset.eyes[1].eye_to_head);
    fake_headset.eyes[0].eye_to_head[0][3] = -0.031f;
    fake_headset.eyes[1].eye_to_head[0][3] = 0.034f;
    Identity(fake_pose.device_to_absolute);
    fake_pose.connected = fake_pose.valid = true;
    host_ok = true;
}
int main() try {
    SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
    SetupHost();
    MemoryQueryParameter query {}; query.size=sizeof(query);
    MemoryRequirement result {};
    Require(TrackerQueryMemory(&query,&result)==0 && result.bytes==WORK_BYTES && result.alignment==WORK_ALIGNMENT,"memory query");
    query.reserved[3]=1; const auto old=result;
    Require(TrackerQueryMemory(&query,&result)==ERROR_INVALID_ARGUMENT && std::memcmp(&result,&old,sizeof(old))==0,"query fail no writes");
    query.reserved[3]=0;
    Require(TrackerQueryMemory(reinterpret_cast<MemoryQueryParameter*>(1),&result)==ERROR_INVALID_ARGUMENT,"bad query address");
    InitializeParameter init {}; init.size=sizeof(init);init.work_address=0x10000;init.work_bytes=WORK_BYTES;init.work_alignment=WORK_ALIGNMENT;
    host_ok=false;
    Require(TrackerInitialize(&init)==ERROR_NOT_INITIALIZED,"real device required");
    host_ok=true;
    Require(TrackerInitialize(&init)==0,"initialize");
    Require(TrackerSetCoordinateSystem(0)==ERROR_INVALID_ARGUMENT && TrackerSetCoordinateSystem(1)==0,"observed coordinate selector");
    Require(TrackerRegisterDevice(1,7)==ERROR_INVALID_ARGUMENT && TrackerRegisterDevice(0,7)==0,"device registration");
    GetResultParameter request {};request.size=sizeof(request);request.device_handle=7;request.predicted_display_time=now_us+20000;
    std::array<uint8_t,0x200> output;output.fill(0xa5);
    const auto prior_headset_calls=headset_calls,prior_tracking_calls=tracking_calls;
    Require(TrackerGetResult(&request,output.data())==0,"live pose result");
    Require(headset_calls==prior_headset_calls&&tracking_calls==prior_tracking_calls+1,"one combined tracking call without redundant headset query");
    Require(U(output.data(),0x18)==1 && Near(last_prediction,0.02f),"valid and requested prediction");
    for(size_t offset:{0x60,0x120}) Require(Near(F(output.data(),offset),0) && Near(F(output.data(),offset+0x1c),1),"identity head camera");
    Require(Near(F(output.data(),0xa0),-0.031f) && Near(F(output.data(),0xe0),0.034f),"actual eye geometry without invented symmetric IPD");
    for(size_t i=0;i<output.size();++i) {
        bool written=i>=0x18&&i<0x1c;
        for(size_t offset:{0x60,0xa0,0xe0,0x120})written|=(i>=offset&&i<offset+12)||(i>=offset+16&&i<offset+32);
        if(!written)Require(output[i]==0xa5,"unknown bytes, time, gaze and padding preserved");
    }
    // A 90-degree Y head rotation moves the eye baseline along Z.
    float (&matrix)[3][4]=fake_pose.device_to_absolute;
    Identity(matrix);matrix[0][0]=0;matrix[0][2]=1;matrix[2][0]=-1;matrix[2][2]=0;
    matrix[0][3]=2;matrix[1][3]=3;matrix[2][3]=4;
    Require(TrackerGetResult(&request,output.data())==0,"rotated pose");
    Require(Near(F(output.data(),0xa0),2)&&Near(F(output.data(),0xa8),4.031f)&&Near(F(output.data(),0xe8),3.966f),"eye composition in head space");
    Require(Near(F(output.data(),0x74),std::sqrt(0.5f))&&Near(F(output.data(),0x7c),std::sqrt(0.5f)),"xyzw rotation");
    Require(std::memcmp(output.data()+0x60,output.data()+0x120,12)==0&&std::memcmp(output.data()+0x70,output.data()+0x130,16)==0,"render and camera same real pose");
    for(unsigned axis=0;axis<3;++axis){Identity(matrix);for(unsigned a=0;a<3;++a)if(a!=axis)matrix[a][a]=-1;ConsumerPose p;Require(PoseFromRigidTransform(matrix,p)&&Near(std::abs(p.orientation[axis]),1),"180 degree quaternion branch");}
    Identity(matrix);matrix[0][0]=-1;
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED&&U(output.data(),0x18)==0,"reflection not a pose");
    Identity(matrix);matrix[1][1]=std::numeric_limits<float>::quiet_NaN();
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED,"nan rejected");
    SetupHost();host_ok=false;
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED&&U(output.data(),0x18)==0,"disconnected invalidates stale validity");
    for(size_t i=0x70;i<0x80;++i)Require(output[i]==0,"failed request cannot replay previous render orientation");
    host_ok=true;fake_pose.valid=false;
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED,"invalid host tracking");
    SetupHost();fake_headset.connected=false;
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED&&U(output.data(),0x18)==0,"disconnected geometry cannot be published");
    SetupHost();request.predicted_display_time=now_us+250001;
    Require(TrackerGetResult(&request,output.data())==ERROR_INVALID_ARGUMENT,"prediction upper bound");
    request.predicted_display_time=now_us-1;
    Require(TrackerGetResult(&request,output.data())==0&&last_prediction==0,"past target uses current prediction");
    request.device_handle=8;Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED,"wrong handle");request.device_handle=7;
    auto* memory=static_cast<uint8_t*>(VirtualAlloc(nullptr,8192,MEM_COMMIT|MEM_RESERVE,PAGE_READWRITE));Require(memory!=nullptr,"test pages");
    std::memset(memory,0x7b,8192);DWORD prior;
    VirtualProtect(memory,4096,PAGE_READONLY,&prior);
    Require(TrackerGetResult(&request,memory)==ERROR_INVALID_ARGUMENT && memory[0x18]==0x7b,"WPM cannot bypass readonly");
    VirtualProtect(memory,4096,PAGE_READWRITE,&prior);VirtualProtect(memory+4096,4096,PAGE_NOACCESS,&prior);
    auto* short_output=memory+4096-0x128;
    Require(TrackerGetResult(&request,short_output)==ERROR_INVALID_ARGUMENT&&short_output[0x60]==0x7b,"preflight prevents partial pose publication");
    Require(TrackerGetResult(reinterpret_cast<GetResultParameter*>(memory+4096-16),output.data())==ERROR_INVALID_ARGUMENT,"partial request unreadable");
    Require(TrackerGetResult(&request,reinterpret_cast<void*>(UINTPTR_MAX-8))==ERROR_INVALID_ARGUMENT,"address overflow");
    VirtualFree(memory,0,MEM_RELEASE);
    Require(TrackerUnregisterDevice(8)==ERROR_INVALID_ARGUMENT&&TrackerUnregisterDevice(7)==0,"unregister lifecycle");
    Require(TrackerGetResult(&request,output.data())==ERROR_NOT_INITIALIZED,"unregistered no pose");
    Require(TrackerRegisterDevice(0,7)==0,"register again");
    std::thread a([&]{for(int i=0;i<50;++i){std::array<uint8_t,0x140> v{}; if(TrackerGetResult(&request,v.data())!=0)std::abort();}});
    std::thread b([&]{for(int i=0;i<50;++i){std::array<uint8_t,0x140> v{}; if(TrackerGetResult(&request,v.data())!=0)std::abort();}});
    a.join();b.join();
    std::printf("PASS VrTracker2 real implementation: %u checks, safe I/O, known-field masks, head/eye transforms and lifecycle\n",checks);
    return 0;
} catch(const std::exception& e){std::fprintf(stderr,"FAIL %s\n",e.what());return 1;}
