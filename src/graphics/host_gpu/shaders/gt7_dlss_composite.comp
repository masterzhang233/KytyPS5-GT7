#version 450
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(binding=0) uniform sampler2D reconstructed;
layout(binding=1) uniform sampler2D effect_layer;
layout(binding=2) uniform sampler2D native_final;
layout(binding=3) uniform sampler2D invalid_motion;
layout(binding=4, rgba16f) uniform writeonly image2D output_color;
layout(push_constant) uniform Push { uint width; uint height; uint low_width; uint low_height; } pc;
vec3 reconstructedLinear(vec2 uv) {
    ivec2 size=textureSize(reconstructed,0);
    vec2 position=uv*vec2(size)-0.5;
    ivec2 lo=ivec2(floor(position));
    vec2 weight=fract(position);
    vec3 a=texelFetch(reconstructed,clamp(lo,ivec2(0),size-1),0).rgb;
    vec3 b=texelFetch(reconstructed,clamp(lo+ivec2(1,0),ivec2(0),size-1),0).rgb;
    vec3 c=texelFetch(reconstructed,clamp(lo+ivec2(0,1),ivec2(0),size-1),0).rgb;
    vec3 d=texelFetch(reconstructed,clamp(lo+ivec2(1,1),ivec2(0),size-1),0).rgb;
    // FP32 weights avoid hardware filter precision varying at the 1.5x ratio.
    return mix(mix(a,b,weight.x),mix(c,d,weight.x),weight.y);
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(p.x>=pc.width || p.y>=pc.height) return;
    vec2 uv=(vec2(p)+0.5)/vec2(pc.width,pc.height);
    // Invalid motion cannot use temporal reconstruction. A conservative 2x2
    // footprint also covers interpolation across the sentinel boundary.
    vec2 low=uv*vec2(pc.low_width,pc.low_height)-0.5;
    ivec2 lo=ivec2(floor(low));
    bool invalid=false;
    for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        ivec2 q=clamp(lo+ivec2(x,y),ivec2(0),ivec2(pc.low_width,pc.low_height)-1);
        invalid=invalid || texelFetch(invalid_motion,q,0).r>0.5;
    }
    vec4 effect=textureLod(effect_layer,uv,0.0);
    // Both guest and private attachments are floating point: preserve coverage
    // outside [0,1] instead of introducing a saturation absent from the draw.
    // Reconstruction is 1440p; the guest's tone-map/UI target remains 4K.
    // Normalized sampling also preserves the old equal-resolution path.
    vec3 color=(1.0-effect.a)*reconstructedLinear(uv)+effect.rgb;
    if(invalid) color=textureLod(native_final,uv,0.0).rgb;
    imageStore(output_color,p,vec4(color,1.0));
}
